<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" stylesheets="@fleet-theme.css" styleClass="app-root"
            fx:controller="com.fuelfleet.cab302fleetfuelplatform.UserManagementController">
    <top>
        <VBox spacing="6" styleClass="top-bar">
            <Label text="ACCESS MANAGEMENT" styleClass="eyebrow"/>
            <Label text="User management" styleClass="page-title"/>
            <Label text="Create driver or fleet manager accounts and control fleet access." styleClass="page-subtitle"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="24">
            <padding><Insets top="18" right="30" bottom="14" left="30"/></padding>
            <TableView fx:id="userTable" prefWidth="500" prefHeight="420">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="250"/>
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="165"/>
                </columns>
            </TableView>
            <VBox spacing="14" prefWidth="300" styleClass="content-card">
                <Label text="Create account" styleClass="section-title"/>
                <GridPane hgap="10" vgap="12">
                    <Label text="Username" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="usernameField" promptText="Username" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <PasswordField fx:id="passwordField" promptText="Password" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Role" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="roleCombo" prefWidth="170" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <Button text="Create account" onAction="#onCreate" maxWidth="Infinity" styleClass="primary-button"/>
                <Button text="Delete Selected" onAction="#onDelete" maxWidth="Infinity"/>
                <Label fx:id="statusLabel" wrapText="true" minHeight="48" styleClass="status-text"/>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox>
            <padding><Insets top="8" right="30" bottom="24" left="30"/></padding>
            <Button text="Back to dashboard" onAction="#onBack" styleClass="ghost-button"/>
        </HBox>
    </bottom>
</BorderPane>