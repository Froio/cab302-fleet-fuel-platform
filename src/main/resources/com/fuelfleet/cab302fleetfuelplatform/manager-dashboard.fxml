<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fuelfleet.cab302fleetfuelplatform.ManagerDashboardController">
  <padding>
    <Insets top="20" right="20" bottom="20" left="20"/>
  </padding>

  <Label text="Manager Dashboard" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
  <HBox spacing="10">
    <Button text="Vehicles" onAction="#onVehicles" />
    <Button text="Reports" onAction="#onReports" />
    <Button text="Logout" onAction="#onLogout" />
  </HBox>

  <Label fx:id="infoLabel" />

</VBox>
