<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fuelfleet.cab302fleetfuelplatform.ManagerDashboardController">
  <padding>
    <Insets top="20" right="20" bottom="20" left="20"/>
  </padding>

  <Label text="Fleet Manager Dashboard" style="-fx-font-size:24px; -fx-font-weight:bold;"/>
  <Label text="Manage fleet users, vehicles, and driver assignments." />
  <HBox spacing="8" alignment="CENTER">
    <Button text="Users" onAction="#onUsers" prefWidth="100" />
    <Button text="Vehicles" onAction="#onVehicles" prefWidth="100" />
    <Button text="Assignments" onAction="#onAssignments" prefWidth="100" />
    <Button text="Drivers" onAction="#onDrivers" prefWidth="100" />
    <Button text="Unassigned" onAction="#onUnassigned" prefWidth="100" />
    <Button text="Profile" onAction="#onProfile" prefWidth="100" />
    <Button text="Reports" onAction="#onReports" prefWidth="100" />
    <Button text="Logout" onAction="#onLogout" prefWidth="90" />
  </HBox>

  <Label fx:id="infoLabel" />

</VBox>