<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fuelfleet.cab302fleetfuelplatform.ManagerRegistrationController"
      alignment="TOP_CENTER" spacing="18">
    <padding><Insets top="36" right="40" bottom="36" left="40"/></padding>

    <Label text="Register Fleet Manager"
           style="-fx-font-size:24px; -fx-font-weight:bold;"/>
    <Label text="Registration is available only until the first Fleet Manager account is created."
           wrapText="true" maxWidth="520"/>

    <GridPane hgap="14" vgap="14" maxWidth="520">
        <Label text="Username" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" promptText="Choose a username" prefWidth="320"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" promptText="Choose a password"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Confirm Password" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Enter the password again"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="statusLabel" wrapText="true" maxWidth="520"/>
    <HBox spacing="12" alignment="CENTER_RIGHT" maxWidth="520">
        <Button text="Back to Login" onAction="#onBack"/>
        <Button fx:id="createButton" text="Create Manager Account" onAction="#onRegister"/>
    </HBox>
</VBox>
