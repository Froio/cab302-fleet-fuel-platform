<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fuelfleet.cab302fleetfuelplatform.UnassignedVehiclesController">
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <Label text="Unassigned Vehicles" style="-fx-font-size:24px; -fx-font-weight:bold;"/>
            <Label text="See which vehicles are available to allocate to a driver."/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets right="24" bottom="12" left="24"/></padding>
            <CheckBox fx:id="unassignedOnlyBox" text="Show unassigned vehicles only" onAction="#onFilter"/>
            <TableView fx:id="vehicleTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="registrationColumn" text="Registration" prefWidth="160"/>
                    <TableColumn fx:id="makeModelColumn" text="Make / Model" prefWidth="220"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="160"/>
                </columns>
            </TableView>
            <Label fx:id="statusLabel" wrapText="true"/>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="8" right="24" bottom="20" left="24"/></padding>
            <Button text="Back to Dashboard" onAction="#onBack"/>
        </HBox>
    </bottom>
</BorderPane>