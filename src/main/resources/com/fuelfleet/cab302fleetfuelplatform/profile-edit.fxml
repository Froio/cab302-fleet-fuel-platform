<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fuelfleet.cab302fleetfuelplatform.ProfileEditController">
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <Label text="My Profile" style="-fx-font-size:24px; -fx-font-weight:bold;"/>
            <Label text="Keep your name and contact email up to date."/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10" maxWidth="400">
            <padding><Insets top="10" right="24" bottom="12" left="24"/></padding>
            <Label text="Name"/>
            <TextField fx:id="nameField" promptText="Full name"/>
            <Label text="Contact email"/>
            <TextField fx:id="emailField" promptText="name@example.com"/>
            <Label fx:id="statusLabel" wrapText="true"/>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="8" right="24" bottom="20" left="24"/></padding>
            <Button text="Back to Dashboard" onAction="#onBack"/>
            <Button text="Save Changes" onAction="#onSave"/>
        </HBox>
    </bottom>
</BorderPane>