<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" stylesheets="@fleet-theme.css" styleClass="app-root"
      fx:controller="com.fuelfleet.cab302fleetfuelplatform.VehicleEditController"
      alignment="TOP_CENTER" spacing="22">
  <padding><Insets top="32" right="40" bottom="32" left="40"/></padding>
  <VBox spacing="6" maxWidth="650" alignment="CENTER_LEFT">
    <Label text="VEHICLE DETAILS" styleClass="eyebrow"/>
    <Label fx:id="titleLabel" text="Register a Vehicle" styleClass="page-title"/>
    <Label fx:id="formDescriptionLabel" text="All fields are required. Registration numbers must be unique." styleClass="page-subtitle"/>
  </VBox>
  <VBox spacing="18" maxWidth="650" styleClass="content-card">
    <Label text="Vehicle information" styleClass="section-title"/>
    <GridPane hgap="14" vgap="14" maxWidth="600">
      <Label text="Registration" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="regField" promptText="e.g. 123 ABC" prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Make" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <TextField fx:id="makeField" promptText="e.g. Toyota" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      <Label text="Model" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
      <TextField fx:id="modelField" promptText="e.g. Corolla" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
      <Label text="Fuel Type" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
      <ComboBox fx:id="fuelTypeCombo" promptText="Select or enter fuel type" prefWidth="300" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
      <Label text="Current Odometer" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
      <TextField fx:id="odometerField" promptText="Whole number" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
      <Label text="Date added" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
      <Label fx:id="dateAddedLabel" text="Recorded automatically when saved" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="statusLabel" wrapText="true" styleClass="status-text"/>
    <HBox spacing="12" alignment="CENTER_RIGHT">
      <Button text="Cancel" onAction="#onCancel"/>
      <Button fx:id="saveButton" text="Save vehicle" onAction="#onSave" styleClass="primary-button"/>
    </HBox>
  </VBox>
</VBox>