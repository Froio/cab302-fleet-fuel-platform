<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1000" prefHeight="700" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fuelfleet.cab302fleetfuelplatform.FuelLoggingController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18">
            <padding><Insets top="18" right="24" bottom="14" left="24"/></padding>
            <Button text="Back" onAction="#onBack" prefWidth="90"/>
            <Label text="Fuel logging" style="-fx-font-size:24px; -fx-font-weight:bold;"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="14" prefWidth="320">
            <padding><Insets top="10" right="20" bottom="20" left="24"/></padding>
            <Label text="Add a fuel log" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <GridPane hgap="10" vgap="12">
                <Label text="Date" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <DatePicker fx:id="datePicker" prefWidth="180" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Vehicle" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="vehicleComboBox" prefWidth="180" promptText="Select vehicle"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Litres" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="litresField" promptText="0.00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Price per litre" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="pricePerLitreField" promptText="0.00"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Total cost" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="totalCostLabel" style="-fx-font-weight:bold;"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Odometer" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="odometerField" promptText="Whole kilometres"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                <CheckBox fx:id="fullTankCheckBox" text="Full tank" selected="true"
                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>
            <Button text="Save Fuel Log" onAction="#onSave" prefWidth="160"/>
            <Label fx:id="statusLabel" wrapText="true" minHeight="44" textFill="#555555"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="24" bottom="20" left="8"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Fuel history" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
                <Button text="Export CSV" onAction="#onExportCsv" prefWidth="120"/>
            </HBox>
            <TableView fx:id="historyTable" prefHeight="570" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="92"/>
                    <TableColumn fx:id="registrationColumn" text="Registration" prefWidth="108"/>
                    <TableColumn fx:id="litresColumn" text="Litres" prefWidth="80"/>
                    <TableColumn fx:id="costColumn" text="Total Cost" prefWidth="90"/>
                    <TableColumn fx:id="odometerColumn" text="Odometer" prefWidth="100"/>
                    <TableColumn fx:id="efficiencyColumn" text="L/100km" prefWidth="90"/>
                    <TableColumn fx:id="fullTankColumn" text="Full Tank" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
