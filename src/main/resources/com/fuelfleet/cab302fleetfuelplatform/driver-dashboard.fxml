<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fuelfleet.cab302fleetfuelplatform.DriverDashboardController">
    <top>
        <VBox spacing="6">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <Label fx:id="welcomeLabel" style="-fx-font-size:24px; -fx-font-weight:bold;"/>
            <Label text="Your assigned vehicles" style="-fx-font-size:15px;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets right="24" bottom="16" left="24"/></padding>
            <TableView fx:id="vehicleTable" prefHeight="430">
                <columns>
                    <TableColumn fx:id="registrationColumn" text="Registration" prefWidth="150"/>
                    <TableColumn fx:id="makeColumn" text="Make" prefWidth="150"/>
                    <TableColumn fx:id="modelColumn" text="Model" prefWidth="150"/>
                    <TableColumn fx:id="fuelTypeColumn" text="Fuel Type" prefWidth="140"/>
                    <TableColumn fx:id="odometerColumn" text="Current Odometer" prefWidth="170"/>
                </columns>
            </TableView>
            <Label fx:id="statusLabel" textFill="#555555"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="24" bottom="20" left="24"/></padding>
            <Button text="Logout" onAction="#onLogout" prefWidth="100"/>
        </HBox>
    </bottom>
</BorderPane>