<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" stylesheets="@fleet-theme.css" styleClass="app-root"
            fx:controller="com.fuelfleet.cab302fleetfuelplatform.DriverDashboardController">
    <top>
        <VBox spacing="6" styleClass="top-bar">
            <Label text="YOUR WORKSPACE" styleClass="eyebrow"/>
            <Label fx:id="welcomeLabel" styleClass="page-title"/>
            <Label text="Your assigned vehicles are listed below." styleClass="page-subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets top="18" right="30" bottom="16" left="30"/></padding>
            <Label text="Assigned vehicles" styleClass="section-title"/>
            <TableView fx:id="vehicleTable" prefHeight="430">
                <columns>
                    <TableColumn fx:id="registrationColumn" text="Registration" prefWidth="150"/>
                    <TableColumn fx:id="makeColumn" text="Make" prefWidth="150"/>
                    <TableColumn fx:id="modelColumn" text="Model" prefWidth="150"/>
                    <TableColumn fx:id="fuelTypeColumn" text="Fuel Type" prefWidth="140"/>
                    <TableColumn fx:id="odometerColumn" text="Current Odometer" prefWidth="170"/>
                </columns>
            </TableView>
            <Label fx:id="statusLabel" styleClass="status-text"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="action-row">
            <padding><Insets top="10" right="30" bottom="24" left="30"/></padding>
            <Button text="Sign out" onAction="#onLogout"/>
            <Button text="+ Add fuel log" onAction="#onAddFuelLog" styleClass="primary-button"/>
        </HBox>
    </bottom>
</BorderPane>