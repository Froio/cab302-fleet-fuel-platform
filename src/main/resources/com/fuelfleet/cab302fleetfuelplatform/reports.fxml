<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml" stylesheets="@fleet-theme.css" styleClass="app-root" fx:controller="com.fuelfleet.cab302fleetfuelplatform.ReportsController" fitToWidth="true" hbarPolicy="NEVER">
 <content>
  <VBox spacing="12">
   <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>
   <HBox spacing="20" alignment="CENTER_LEFT"><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="ANALYTICS" styleClass="eyebrow"/><Label text="Fleet reports" styleClass="page-title"/><Label text="Review expenditure, efficiency and estimated emissions." styleClass="page-subtitle"/></VBox><Button text="Back" onAction="#onBack" styleClass="ghost-button"/></HBox>
   <FlowPane hgap="8" vgap="8" styleClass="content-card">
    <Label text="Vehicle"/><ComboBox fx:id="vehicle" promptText="All vehicles" prefWidth="230"/>
    <Button text="All vehicles" onAction="#onAllVehicles"/>
    <Label text="From"/><DatePicker fx:id="fromDate" prefWidth="140"/>
    <Label text="To"/><DatePicker fx:id="toDate" prefWidth="140"/>
    <Button text="Apply / refresh" onAction="#onRefresh" styleClass="primary-button"/>
   </FlowPane>
   <Label text="Fuel expenditure by vehicle" styleClass="section-title"/>
   <Label fx:id="expenditureTotal" styleClass="section-title"/>
   <Label text="Uses stored fuel entries and the selected dates. Refreshes every 5 seconds while filters are not being edited." wrapText="true"/>
   <TableView fx:id="expenditureTable" prefHeight="160" minHeight="160">
    <columns>
     <TableColumn fx:id="expenseVehicle" text="Vehicle" prefWidth="430"/>
     <TableColumn fx:id="expenseEntries" text="Fuel entries" prefWidth="120"/>
     <TableColumn fx:id="expenseCost" text="Cost (AUD)" prefWidth="160"/>
    </columns>
   </TableView>
   <Label fx:id="summary" wrapText="true" minHeight="-Infinity" styleClass="content-card" maxWidth="Infinity"/>
   <Label fx:id="status" wrapText="true" minHeight="-Infinity" styleClass="status-text"/>
   <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="390" minHeight="390">
    <tabs>
     <Tab text="Fuel cost"><LineChart fx:id="costChart" title="Monthly fuel expenditure" animated="false" legendVisible="false"><xAxis><CategoryAxis label="Month (YYYY-MM)"/></xAxis><yAxis><NumberAxis label="Cost (AUD)" forceZeroInRange="true"/></yAxis></LineChart></Tab>
     <Tab text="Estimated emissions"><LineChart fx:id="emissionsChart" title="Monthly estimated tailpipe CO₂" animated="false" legendVisible="false"><xAxis><CategoryAxis label="Month (YYYY-MM)"/></xAxis><yAxis><NumberAxis label="Estimated CO₂ (kg)" forceZeroInRange="true"/></yAxis></LineChart></Tab>
     <Tab text="Fuel efficiency"><LineChart fx:id="efficiencyChart" title="Full-tank interval efficiency" animated="false" legendVisible="false"><xAxis><CategoryAxis label="Interval ending month (YYYY-MM)"/></xAxis><yAxis><NumberAxis label="Fuel efficiency (L/100 km)" forceZeroInRange="true"/></yAxis></LineChart></Tab>
    </tabs>
   </TabPane>
   <Label wrapText="true" minHeight="-Infinity" styleClass="muted-text" text="Estimates use recorded litres as a proxy for consumption. EPA factors: petrol 8.887 kg / US gallon; diesel 10.180 kg / US gallon (3.785411784 L). Tailpipe CO₂ only; excludes upstream emissions and other gases."/>
   <Label wrapText="true" minHeight="-Infinity" styleClass="muted-text" text="Efficiency assumes every fill-up is logged and full-tank markers are accurate. Intervals are assigned to their ending month; they may start before the selected period. Missing values are unavailable, not zero."/>
  </VBox>
 </content>
</ScrollPane>